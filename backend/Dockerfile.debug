FROM ubuntu:24.04

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    libmariadb-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libmicrohttpd-dev \
    nlohmann-json3-dev \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY app /app/app
COPY backend/debug.sh /app/debug.sh

RUN chmod +x /app/debug.sh && /app/debug.sh
